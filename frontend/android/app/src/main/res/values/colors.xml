<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 2026-10-04 建立。此前 styles.xml 引用 @color/colorPrimary 却**没有**这个文件
         （Capacitor 模板删得太干净），是颗定时炸弹：将来任何一次 clean build 都可能
         报 "resource color/colorPrimary not found"。这里补齐，同时统一品牌色。 -->

    <!-- 品牌主色 #e5484d（同花顺红, 2026-10-04 主人反馈 #c62828 太深调浅）：
         与前端顶栏/theme-color/manifest 一致
         （🔴 XML 注释里不许出现连续两个短横线，所以这里变量名的前导符省略了） -->
    <color name="colorPrimary">#e5484d</color>
    <color name="colorPrimaryDark">#e5484d</color>
    <color name="colorAccent">#e5484d</color>

    <!-- 启动屏底色：**2026-10-05 由品牌红改为纯白**（主人：「首页启动全是红色，应该白底 + logo + 标语」，
         并给了同花顺启动屏作参考）。
         ★ 为什么可以改白而不闪：网页侧新增的 #boot-splash（index.html）也是白底 + logo + 标语
           ⇒ native 白 → 网页白，衔接处没有色块跳变；此前之所以用红色，正是因为当时网页侧没有启动页，
             只能靠"红底"在视觉上表示"正在加载"。
         🔴 状态栏那条红（AppTheme.NoActionBar 的 windowBackground=colorPrimary）保持不动 ——
            它要跟手机端浅色主题的红色顶栏连成一体，与启动屏是两件事。 -->
    <color name="splash_background">#ffffff</color>

    <!-- 🔴 ic_launcher_background 不在此处定义：
         Capacitor 生成的 values/ic_launcher_background.xml 里已有同名资源，
         两个文件定义同名 <color> 会直接让资源合并失败（duplicate resource）。 -->
</resources>
