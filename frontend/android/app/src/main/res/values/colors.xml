<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 2026-10-04 建立。此前 styles.xml 引用 @color/colorPrimary 却**没有**这个文件
         （Capacitor 模板删得太干净），是颗定时炸弹：将来任何一次 clean build 都可能
         报 "resource color/colorPrimary not found"。这里补齐，同时统一品牌色。 -->

    <!-- 品牌主色 #e5484d（同花顺红, 2026-10-04 主人反馈 #c62828 太深调浅）：
         与前端顶栏/theme-color/manifest 一致
         （🔴 XML 注释里不许出现连续两个短横线，所以这里变量名的前导符省略了） -->
    <color name="colorPrimary">#e5484d</color>
    <color name="colorPrimaryDark">#e5484d</color>
    <color name="colorAccent">#e5484d</color>

    <!-- 启动屏底色：**2026-10-05 由品牌红改为纯白**（主人：「首页启动全是红色，应该白底 + logo + 标语」，
         并给了同花顺启动屏作参考）。
         ★ 为什么可以改白而不闪：网页侧新增的 #boot-splash（index.html）也是白底 + logo + 标语
           ⇒ native 白 → 网页白，衔接处没有色块跳变；此前之所以用红色，正是因为当时网页侧没有启动页，
             只能靠"红底"在视觉上表示"正在加载"。
         🔴 状态栏那条红（AppTheme.NoActionBar 的 windowBackground=colorPrimary）保持不动 ——
            它要跟手机端浅色主题的红色顶栏连成一体，与启动屏是两件事。 -->
    <color name="splash_background">#ffffff</color>

    <!-- 2026-10-05（v1.8.1）主人：「底部红条还是存在」+「深色下上面下面都该是深色」。
         🔴 机制：**gesture 导航下 navigationBarColor 是无效的**（系统强制透明），
            所以底部露的是 `windowBackground`。原来 windowBackground 与 statusBarColor
            共用同一个品牌红是为了染红状态栏 —— 但代价是底部也被染红，两者从此绑死。
         修法：把它们**拆开**并都做成随系统深浅色变化：
           · statusBarBrand  → 只染状态栏。浅色 = 品牌红（与浅色红顶栏连成一体，主人 10-04 拍板）；
                              深色 = 深色（与深色顶栏一致 ⇒ 深色模式上下都是深色）
           · windowBg        → 窗口底色，**底部露的就是它**。浅色 = 白（与白色 tab 栏一致）；
                              深色 = #0f1219（与深色 tab 栏一致）
         ⇒ 底部不再是红的；深色模式顶/底都变深色。
         （深色变体见 values-night/colors.xml） -->
    <color name="statusBarBrand">#c62828</color>
    <color name="windowBg">#ffffff</color>

    <!-- 2026-10-05 (APK v1.8)：**系统导航栏**底色（不是启动屏、不是状态栏）。
         浅色主题给白 —— 与底部 tab 栏白底一致，消除"底部一条红"（原为 windowBackground
         的品牌红露出）。深色变体见 values-night/colors.xml。 -->
    <color name="navBarBackground">#ffffff</color>

    <!-- 2026-10-05 (APK 1.8.3) 主人反馈：「信号那一栏现在是黑的，字和信号都看不见了」＋
         「不应该是 app 和系统颜色联动吗」。
         🔴 根因：那条带子此前由 **DayNight 资源**决定（values-night 里是 #0f1219）⇒
            它跟着**系统**深浅色走；而 App 自己的主题存在网页里（账号 prefs / 本地），
            两者是独立源头 ⇒ 系统深色 + App 浅色（红顶栏）时：上面一条黑、下面一条红，
            黑底再叠深色图标 ⇒ 时间和信号看不见。
         修法：**以 App 主题为唯一源头** —— 网页每次应用主题时经 KxThemePlugin
            一次性改写窗口底/状态栏/导航栏（见该插件注释）。
         ⚠️ 这里的 kx* 颜色**刻意只写在 values/ 里（不做 values-night 变体）**：
            运行时由网页显式传 mode 选择，不再被系统深浅色偷偷换掉。 -->
    <color name="kxStatusBarLight">#c62828</color>   <!-- 浅色主题：与红顶栏连成一体 -->
    <color name="kxStatusBarDark">#0f1219</color>    <!-- 深色主题：与深色顶栏同值 -->
    <color name="kxWindowLight">#f0f2f7</color>      <!-- 与网页浅色页面底同值 -->
    <color name="kxWindowDark">#0f1219</color>
    <color name="kxNavBarLight">#f0f2f7</color>
    <color name="kxNavBarDark">#0f1219</color>

    <!-- 🔴 ic_launcher_background 不在此处定义：
         Capacitor 生成的 values/ic_launcher_background.xml 里已有同名资源，
         两个文件定义同名 <color> 会直接让资源合并失败（duplicate resource）。 -->
</resources>
