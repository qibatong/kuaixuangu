<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- 2026-10-04 状态栏品牌红(与浅色红顶栏连成一体, 白色图标)。
             🔴 Android 15+(targetSdk 35+) 强制 edge-to-edge: 本主题的 statusBarColor/
             windowLightStatusBar 都被系统忽略 —— Capacitor 会把 WebView 顶部推到状态栏下,
             状态栏区域露的是**窗口背景**(白色, 这就是主人截图中"信号栏没被红色覆盖"的根因)。
             ⇒ 补 android:windowBackground 染红; 白色图标由 MainActivity 里
             WindowCompat.setAppearanceLightStatusBars(false) 兜(API 35+ 分支)。 -->
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/colorPrimary</item>
    </style>


    <!-- 2026-10-04：换成自定义的**品牌红**启动屏（原先 @drawable/splash 是 Capacitor
         默认的浅色图 ⇒ 点开包那一瞬上下白边，看着像"闪白屏"）。
         ★ 实测取舍（AVD android-34）：曾试过 windowSplashScreenAnimatedIcon 里组合
           「图标+正在加载文字」，但系统 12+ 对 icon 层有强制圆形 mask + 缩放动画，
           文字必被裁掉/变形 ⇒ 放弃叠字。加载提示由两层机制保证：
           ① 启动屏底色=品牌红，用户一进去看到红屏即知"在加载"；
           ② 新前端页面就绪立即 SplashScreen.hide()（见 src/App.vue），无白屏空窗。 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowBackground">@drawable/splash_brand</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>
</resources>