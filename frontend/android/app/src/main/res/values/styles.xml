<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- 2026-10-04 状态栏品牌红(与浅色红顶栏连成一体, 白色图标)。
             🔴 Android 15+(targetSdk 35+) 强制 edge-to-edge: 本主题的 statusBarColor/
             windowLightStatusBar 都被系统忽略 —— Capacitor 会把 WebView 顶部推到状态栏下,
             状态栏区域露的是**窗口背景**(白色, 这就是主人截图中"信号栏没被红色覆盖"的根因)。
             ⇒ 补 android:windowBackground 染红; 白色图标由 MainActivity 里
             WindowCompat.setAppearanceLightStatusBars(false) 兜(API 35+ 分支)。 -->
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/colorPrimary</item>
        <!-- 🔴 2026-10-05（v1.8）主人：「页面底部那条红是干啥的」—— 它就是上面的
             windowBackground（品牌红）在**系统导航栏区域**露出来的：
             Android 15+ 强制 edge-to-edge ⇒ statusBarColor/navigationBarColor **全部被忽略**、
             两条系统栏变透明，而 WebView 仍被内缩 ⇒ 上下两条栏都露"窗口背景"。
             10-04 为了把状态栏染红（与浅色红顶栏连成一体）才设了 windowBackground=红色；
             代价是**底部导航栏也被染红**（底下是白色底栏，红条就格外扎眼）。
             ⇒ 修法两步：
               ① 用官方提供的 opt-out 让 statusBarColor/navigationBarColor **重新生效**
                  （Android 15 起可用；不写这个，下面那条 navigationBarColor 是空话）。
               ② 导航栏颜色按深浅主题分别给（@color/navBarBackground 有 values-night 变体）
                  —— 浅色主题给白、深色主题给深色，与底部 tab 栏底色一致。
             ⚠️ 已知局限：原生颜色是**静态**的，只跟随**系统**深/浅色设置；
                若系统是浅色而 App 内选了深色（或反之），底部会是一条不匹配的纯色。
                要做到严格跟随 App 内主题，得改走"真 edge-to-edge + 网页自己用 safe-area 画"，
                那是更大的改动，需要真机验证，单独排。 -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:navigationBarColor">@color/navBarBackground</item>
        <item name="android:windowLightNavigationBar">@bool/navBarLightIcons</item>
    </style>


    <!-- 2026-10-05：启动屏**由品牌红改为纯白**（主人：「首页启动全是红色，应该白底 + logo + 标语」，
         并给了同花顺启动屏作参考）。底色值见 values/colors.xml 的 splash_background（#ffffff），
         windowBackground 见 drawable/splash_brand.xml（白底 + 居中图标，已去掉红底配的白字）。
         ★ 为什么现在能改白而不"闪"：网页侧新增了 #boot-splash（index.html，白底 + logo + 标语 +
           「快选股」）⇒ native 白 → 网页白，衔接处无跳变。当初用红底正是因为网页侧没有启动页。
         ★ 历史取舍（2026-10-04 · AVD android-34 实测）：曾试过在 windowSplashScreenAnimatedIcon
           里组合「图标 + 正在加载文字」，但系统 12+ 对 icon 层有强制圆形 mask + 缩放动画，
           文字必被裁掉/变形 ⇒ 放弃叠字。**标语与品牌字改由网页侧启动页承担**，本层只放图标。
         ★ 加载提示仍由两层机制保证：① 启动屏一出现即知"在加载"；② 新前端页面就绪立即
           SplashScreen.hide()（见 src/App.vue），无白屏空窗。 -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowBackground">@drawable/splash_brand</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>
</resources>