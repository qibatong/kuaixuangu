<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 2026-10-05 (APK v1.8)：系统处于**深色模式**时的系统栏配色。
         底色取页面深色主题的背景基色（main.css 里那个深色渐变底，起点 #0f1219），
         让底部导航栏与 App 深色底栏连成一体。 -->
    <color name="navBarBackground">#0f1219</color>

    <!-- 2026-10-05（v1.8.1）主人在深色模式下截图反馈：「上面下面都该是深色，怎么还有红色背景」。
         深色模式下 App 顶栏本身是深色的（红色顶栏规则只作用于浅色主题），
         他却看到顶/底都红 —— 因为 native 的 statusBarColor 与 windowBackground **都是品牌红**
         且不随主题变。⇒ 深色变体里两者都改成深色（与深色顶栏/tab 栏一致）。 -->
    <color name="statusBarBrand">#0f1219</color>
    <color name="windowBg">#0f1219</color>

    <!-- 2026-10-05（主人：「深色模式下黑色色值不统一」）：现在统一到同一个
         #0f1219（网页侧的页面底与屏幕边缘 token 也已由渐变改为该纯色），
         状态栏区、顶栏、页面、底栏、导航栏区**五处同值** ⇒ 不再有任何色带。
         这里补 splash_background：此前它只在浅色目录里定义为 #ffffff，
         深色模式启动时会闪一下白底（与深色主题不一致），补上深色变体。
         注意：XML 注释内不能出现连续的两个短横线。 -->
    <color name="splash_background">#0f1219</color>
</resources>
