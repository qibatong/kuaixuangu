{
  "name": "bid-selector-frontend",
  "private": true,
  "version": "2.0.0",
  "description": "快速选股前端 (Vue 3 + Vite + Pinia + Vue Router)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/utils/*.test.js",
    "test:nav": "vite build --ssr _verify/nav.spec.js --outDir .navssr --emptyOutDir && node .navssr/nav.spec.js",
    "test:spot": "vite build --ssr _verify/spot.spec.js --outDir .spotssr --emptyOutDir && node .spotssr/spot.spec.js",
    "test:adm": "vite build --ssr _verify/admin_scoring.spec.js --outDir .admssr --emptyOutDir && node .admssr/admin_scoring.spec.js",
    "test:board": "vite build --ssr _verify/board_refresh.spec.js --outDir .boardssr --emptyOutDir && node .boardssr/board_refresh.spec.js",
    "test:concept": "vite build --ssr _verify/concept_main.spec.js --outDir .cmspec --emptyOutDir && node .cmspec/concept_main.spec.js",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && node _verify/css_scroll_guard.js && node _verify/color_guard.js && node _verify/breakpoint_guard.js && node _verify/fa_guard.js && npm run test:nav && npm run test:spot && npm run test:adm && npm run test:board",
    "lint": "eslint src --ext .js,.vue",
    "lint:fix": "eslint src --ext .js,.vue --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css}\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "echarts": "^6.1.0",
    "lxgw-wenkai-webfont": "^1.7.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "typescript": "^7.0.2",
    "vite": "^5.2.0"
  }
}
